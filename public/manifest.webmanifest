{
  "name": "Dezen Admin",
  "short_name": "Dezen Admin",
  "description": "The staff tool for Shopping, DezenFoods and DezenExpress.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#212428",
