# The backend, including /api/v1 (e.g. https://api.dezenmart.com/api/v1)
VITE_API_URL=http://localhost:3000/api/v1
# true (default): the admin runs on built-in sample data, no backend needed.
# Set to false once the backend endpoints in docs/BACKEND_CHECKLIST.md exist.
VITE_USE_SAMPLE_DATA=true
# While sample data is on, these areas use the real backend instead (comma-separated).
# Areas: home, search, claims, approvals, food, express, shopping, people, money, settings, staff.
# Sign-in goes live with the first one. Example: VITE_LIVE_AREAS=food,approvals
VITE_LIVE_AREAS=
